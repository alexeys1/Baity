# Normalize text files to LF in the repository; working tree uses LF on all platforms.
* text=auto eol=lf

*.java text eol=lf
*.json text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.accesswidener text eol=lf
*.mixins.json text eol=lf
*.lang text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.txt text eol=lf

*.sh text eol=lf
gradlew text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.ogg binary
*.wav binary
*.zip binary
*.class binary
